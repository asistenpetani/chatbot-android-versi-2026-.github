rules_version = '2';

// Firebase Storage Rules
// Mengamankan data file/foto di Cloud Storage
service firebase.storage {
  match /b/{bucket}/o {
    
    // Aturan dasar: Harus login untuk bisa mengakses
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Aturan khusus untuk folder foto profil
    match /profile_photos/{userId}/{fileName} {
      // Hanya user yang bersangkutan yang bisa mengunggah atau mengubah foto profilnya
      // Maksimal ukuran foto 5MB dan harus berupa gambar (image/*)
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
    }
    
    // Aturan khusus untuk folder diagnosa (foto tanaman)
    match /diagnosa_photos/{userId}/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024 // 10MB
                   && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null && request.auth.uid == userId;
    }
  }
}
