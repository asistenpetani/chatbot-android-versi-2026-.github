rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // POC Aturan Koleksi Petani
    match /petani/{userId} {
      // Hanya mengizinkan baca/tulis jika UID dari token Android COCOK dengan ID dokumen
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // POC Aturan Koleksi Riwayat AI
    match /riwayat_ai/{userId}/percakapan/{chatId} {
      // Klien Android hanya boleh BACA riwayat chatnya sendiri.
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Aplikasi Android SAMA SEKALI DILARANG menulis langsung riwayat chat!
      // Hanya Backend (via Service Account sa-compute-ai) yang punya akses ini.
      allow write: if false; 
    }
  }
}
